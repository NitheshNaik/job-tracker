# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <dbname> with your own Atlas values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production (e.g. https://job-tracker.vercel.app)
# Falls back to http://localhost:5173 in development if not set
FRONTEND_URL=http://localhost:5173

# ─── Auth (to be added in a later stage) ──────────────────────────────────────
# JWT_SECRET=your_super_secret_key
# JWT_EXPIRES_IN=7d
