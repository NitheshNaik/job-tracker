# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <dbname> with your own Atlas values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production (e.g. https://job-tracker.vercel.app)
# Falls back to http://localhost:5173 in development if not set
FRONTEND_URL=http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — Add both of these to Render Environment Variables as well.
# JWT_SECRET must be a long, random, secret string (min 32 chars).
# Changing it after deployment invalidates all existing user sessions.
JWT_SECRET=your_long_random_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
